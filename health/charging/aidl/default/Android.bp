rust_library {
    name: "libcharge_limit_hal",
    crate_name: "charge_limit_hal",
    vendor: true,
    crate_root: "src/lib.rs",
    srcs: ["src/*.rs"],
    // Platform lints, with clippy, instead of the vendor lints used for code under hardware/.
    lints: "android",
    clippy_lints: "android",
    rustlibs: [
        "custom.hardware.health.charging-V2-rust",
        "libandroid_logger",
        "libbinder_rs",
        "libkobject_uevent",
        "liblibc",
        "liblog_rust",
        "libnetlink_sys",
        "libsignal_hook",
        "libthiserror",
        "libtokio",
    ],
}

// The service run by the library, declared at the AIDL version linked above. Each device binary
// lists it in vintf_fragment_modules.
vintf_fragment {
    name: "custom.hardware.health.charging-service.xml",
    src: "custom.hardware.health.charging-service.xml",
    vendor: true,
}

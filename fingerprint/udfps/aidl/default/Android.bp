cc_binary {
    name: "custom.hardware.biometrics.fingerprint.udfps-service.default",
    vintf_fragments: ["custom.hardware.biometrics.fingerprint.udfps-service.default.xml"],
    init_rc: ["custom.hardware.biometrics.fingerprint.udfps-service.default.rc"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "UdfpsExtension.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "custom.hardware.biometrics.fingerprint.udfps-V1-ndk",
    ],
}

<compatibility-matrix version="2.0" type="framework">
    <!-- UDFPS z-order control -->
    <hal format="aidl" optional="true">
        <name>custom.hardware.biometrics.fingerprint.udfps</name>
        <version>1</version>
        <interface>
            <name>IUdfpsExtension</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- LTPO idle control -->
    <hal format="aidl" optional="true">
        <name>custom.hardware.display.ltpo</name>
        <version>1-2</version>
        <interface>
            <name>ILtpoControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Codec features -->
    <hal format="aidl" optional="true">
        <name>custom.media.codec</name>
        <version>1</version>
        <interface>
            <name>ICodecFeatures</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
